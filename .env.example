# Copy to .env and fill in. All values are optional.

# Enables the Claude-powered investment assistant. Without it, the offline
# analyst answers (retrieval-grounded, deterministic).
ANTHROPIC_API_KEY=

# Model for the assistant (default: claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5

# Server-side refusal fallbacks are on by default; set to "off" to disable.
# CLAUDE_FALLBACKS=off

# Production server binding (npm start).
# PORT=4173
# HOST=127.0.0.1
