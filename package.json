{
  "name": "gods-eye-view",
  "private": true,
  "version": "1.0.0",
  "description": "Investment Agentic AI prototype \u2014 a map-centric decision-support platform that takes a Dubai Municipality plot from asset intelligence through Highest & Best Use, investment structuring, financial feasibility, recommendation, human review and Commercial Assets Portfolio capture.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start",
    "build:artifact": "node scripts/build-artifact.mjs",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:pages": "vite build --base=/gods-eye-view/ --outDir dist-pages && node -e \"require('fs').writeFileSync('dist-pages/.nojekyll', '')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "jspdf": "^4.2.1",
    "maplibre-gl": "^5.6.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "prettier": "^3.6.0",
    "vite": "^6.3.0"
  }
}
